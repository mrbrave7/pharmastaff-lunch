# Copy this file to .env and fill in your values.
# Load it with:  export $(grep -v '^#' .env | xargs)  &&  python main.py

# ── Required ──
BOT_TOKEN=8757500664:AAHKwhEVTMuLlk9UbkEEsi0qXXrAWqo5G6E
ADMIN_ID=7645204689

# ── Optional ──
CARD_NUMBER=1234 5678 9012 3456
TIMEZONE=Asia/Tashkent

# Public HTTPS URL of the Mini App (e.g. your ngrok URL). Leave empty to run the
# bot with inline buttons only — no web app button is shown when this is unset.
WEBAPP_URL=

# Web server bind (the Mini App + health). PORT must match what you tunnel.
HOST=0.0.0.0
PORT=7771

# SQLite file (created automatically on first run).
DB_FILE=lunch_bot.db

# Notification times (24h, local to TIMEZONE).
EVENING_NOTIFY_HOUR=21
REMINDER_HOUR=12
VOTE_END_HOUR=15
